# =============================================================================
# CareerAI — Environment variables template
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# --- LLM (Gemini) -----------------------------------------------------------
# Required. Obtain at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model name. gemini-1.5-flash is fastest/cheapest for keyword extraction.
GEMINI_MODEL=gemini-1.5-flash

# --- Backend ---------------------------------------------------------------
# Where generated CVs are written inside the backend container.
# Mounted to a Docker volume in docker-compose.yml so PDFs survive restarts.
CV_OUTPUT_DIR=/app/storage/cvs
# Comma-separated list of allowed CORS origins (frontend URLs).
CORS_ORIGINS=http://localhost:5173

# --- Frontend --------------------------------------------------------------
# Backend URL the React app will hit. Read by Vite at build time.
VITE_API_URL=http://localhost:8000

# --- Postgres (provisioned but UNUSED by CV Engine today) ------------------
# Kept here so docker-compose can start the service. Backend does not connect
# to it in this sprint — no psycopg2 in requirements.txt yet.
POSTGRES_USER=careerai
POSTGRES_PASSWORD=careerai_dev
POSTGRES_DB=careerai
DATABASE_URL=postgresql://careerai:careerai_dev@postgres:5432/careerai

# --- Redis (provisioned but UNUSED by CV Engine today) ---------------------
REDIS_URL=redis://redis:6379/0
